# Copiar a .env:  cp .env.example .env
# .env no se versiona. Valores alineados con src/config.ts (defaults de Zod).

NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/app.db
SESSION_TTL_HOURS=168

# Orígenes permitidos por CORS, separados por coma. La app nativa no envía
# Origin; esto solo afecta a Expo web.
CORS_ORIGINS=http://localhost:8081

# Rate limiting. El store es en memoria: reiniciar el servidor resetea
# todos los contadores, y no se comparte entre varias instancias.
# Valores de dev (abajo) / valores recomendados para producción (comentario).
RATE_LIMIT_GLOBAL_PER_15MIN=300
# Producción: 5
RATE_LIMIT_REGISTER_PER_HOUR=30
RATE_LIMIT_LOGIN_IP_PER_15MIN=10
# Cuenta los intentos fallidos por email normalizado, exista o no la cuenta.
RATE_LIMIT_LOGIN_EMAIL_PER_15MIN=5

# Recuperación de contraseña y verificación de email (Fase 4).
RATE_LIMIT_PASSWORD_IP_PER_15MIN=10
# Mails de recuperación por email normalizado, exista o no la cuenta.
RATE_LIMIT_PASSWORD_EMAIL_PER_15MIN=3
RATE_LIMIT_VERIFY_EMAIL_PER_15MIN=10
CODE_TTL_MINUTES=15
CODE_MAX_ATTEMPTS=5

# Mail local: Mailpit (docker compose up mailpit). Bandeja en http://localhost:8025.
# Dentro de docker compose el backend usa SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=WOD <no-reply@wod.local>
